                  "        pm.collectionVariables.set('accessToken', response.data.tokens.access_token);",
                  "        pm.collectionVariables.set('csrfToken', response.data.tokens.csrf_token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "users", "refresh"]
            },
            "description": "Refresh access token menggunakan refresh token dari HTTP-only cookie"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "users", "logout"]
            },
            "description": "Logout user dan revoke session (memerlukan CSRF token)"
          },
          "response": []
        }
      ]
